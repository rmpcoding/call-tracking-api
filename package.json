{
  "name": "call-tracking-api",
  "version": "1.0.0",
  "description": "This is the call tracking api.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"node --watch --watch-preserve-output ./src/server.ts\" \"tsc --noEmit --watch --preserveWatchOutput\"",
    "build": "tsc",
    "start": "node ./dist/server.js",
    "typecheck": "tsc --noEmit --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmpcoding/call-tracking-api.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/rmpcoding/call-tracking-api/issues"
  },
  "homepage": "https://github.com/rmpcoding/call-tracking-api#readme",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.3.0",
    "fastify": "^5.12.7",
    "typebox": "^1.4.2"
  }
}
